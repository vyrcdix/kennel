# server/.env.example — copy to server/.env.local and fill in real values.
# Loaded by `npm run dev` / `npm run migrate` / `npm run seed` via Node's
# --env-file-if-exists flag. Prod reads the equivalent file via systemd
# EnvironmentFile=/etc/kennel/secrets.env (see docs/kennel-sys-admin-guide.md).
#
# DO NOT commit .env.local; .gitignore already excludes .env.*.

# Anthropic — for Smart Routing's classifier (Phase 0 onwards).
# Create at https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# MCP bearer token — Claude clients send this in the Authorization header.
# Generate with: openssl rand -hex 32
# Leave blank in dev (auth is permissive); set on prod.
KENNEL_MCP_TOKEN=

# One-shot seed for the web-UI password on a fresh DB. Read once at boot;
# inert after the password is stored. Leave blank in dev.
KENNEL_INITIAL_PASSWORD=

# Optional: skip the demo-fixture seed on first boot. Set to 1 on prod.
# Unset / 0 in dev so the dashboard has data to look at.
# KENNEL_SKIP_SEED=1
